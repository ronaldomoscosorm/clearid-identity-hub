# ─────────────────────────────────────────────────────────────────────────────
# Portal Argus (ArthosMFA) — SSO por cookie compartilhado .rmtecho.com.br
# ─────────────────────────────────────────────────────────────────────────────
# Autenticação de USUÁRIO — o Portal Argus emite o JWT via cookie HttpOnly
# `rmtecho_token` no domínio `.rmtecho.com.br`. O frontend não precisa ler o
# token; o browser envia automaticamente em toda chamada same-site.
#
# URL de login para redirect quando não autenticado.
# Em prod: https://portal.rmtecho.com.br/login
# Em dev:  http://localhost:5100/login (ou o que o ArthosMFA estiver servindo)
VITE_PORTAL_ARGUS_LOGIN_URL="https://portal.rmtecho.com.br/login"

# (Opcional) Base da API do Portal Argus para consumir /access-profiles/{id}/operations.
# Default: https://portal.rmtecho.com.br/api
# VITE_PORTAL_ARGUS_API_URL="https://portal.rmtecho.com.br/api"

# Backend clearid (dados/identities). Inlined no build (VITE_*). Default já é produção,
# então em prod pode omitir. Útil para apontar a um backend alternativo.
# VITE_ARGUS_API_BASE_URL="https://argusclearidapi.rmtecho.com.br"

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — sessão TÉCNICA para acessar DADOS (branding, settings, etc.).
# NÃO é auth de USUÁRIO (essa vem do Portal Argus, acima).
# Onde obter: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Usuário técnico do Supabase (login automático em background para abrir sessão
# que dispara o RLS). Crie no Supabase Auth (Authentication → Users → Add user,
# Auto Confirm). Atenção: expostas no bundle — use usuário dedicado e restrito
# por RLS somente ao necessário.
VITE_SUPABASE_APP_EMAIL="app@seu-dominio.com"
VITE_SUPABASE_APP_PASSWORD="senha-do-usuario-tecnico"

# DEV ONLY — mock do usuário logado (testa restrições por usuário sem backend/Portal).
# JSON de CurrentUser. Só ativa com `vite dev` (import.meta.env.DEV). Deixe vazio em prod.
# VITE_DEV_MOCK_USER='{"username":"dev.local","apps":["argus"],"argusProfile":"Administrador","roles":[],"accessProfileId":"0","sites":["RM:RM","Corteva:Demo Site"]}'

# DEV ONLY — mock das permissões de menu por perfil (testa a filtragem menu×perfil sem o Portal).
# JSON de AccessProfileOperation[] ({ menuKey, select, insert, update, delete }).
# Use com um VITE_DEV_MOCK_USER cujo accessProfileId seja != "0" (senão cai no bypass e mostra tudo).
# Ex.: perfil "Operador" (só cadastro básico):
# VITE_DEV_MOCK_OPERATIONS='[{"menuKey":"cadastro","select":true,"insert":false,"update":false,"delete":false},{"menuKey":"identities","select":true,"insert":true,"update":true,"delete":false},{"menuKey":"visitas","select":true,"insert":true,"update":false,"delete":false}]'
