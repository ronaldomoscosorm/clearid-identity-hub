# Configuração Supabase — copie para .env e preencha com os valores do projeto.
# NÃO commite o .env real (ele está no .gitignore).
#
# Onde obter: Supabase Dashboard → Project Settings → API
#   - Project URL           -> SUPABASE_URL / VITE_SUPABASE_URL
#   - Project ID (ref)       -> SUPABASE_PROJECT_ID / VITE_SUPABASE_PROJECT_ID
#   - anon / public key      -> SUPABASE_PUBLISHABLE_KEY / VITE_SUPABASE_PUBLISHABLE_KEY (pública)
#   - service_role key       -> SUPABASE_SERVICE_ROLE_KEY (SECRETA — só no servidor, ignora RLS)

SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Usuário técnico para login automático (behind the scenes).
# Crie no Supabase Auth (Authentication → Users → Add user, Auto Confirm).
# Atenção: ficam expostas no bundle do frontend — use usuário dedicado e limitado por RLS.
VITE_SUPABASE_APP_EMAIL="app@seu-dominio.com"
VITE_SUPABASE_APP_PASSWORD="senha-do-usuario-tecnico"
