{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "argus-scsaas",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DOTNET_ROLL_FORWARD=Major",
        "dotnet",
        "run",
        "--project",
        "../ArgusClearID/ArgusSCSaaS/ArgusSCSaaS.csproj",
        "--urls",
        "http://localhost:5081"
      ],
      "port": 5081
    },
    {
      "name": "portal-front",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "/Users/ronaldomoscoso/Projects/portal-argus-frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "argus-clearid-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DOTNET_ROLL_FORWARD=Major",
        "AuthenticationSettings__Enabled=false",
        "ASPNETCORE_ENVIRONMENT=Development",
        "dotnet",
        "run",
        "--project",
        "../ArgusClearID/ArgusClearId.Api/ArgusClearId.Api.csproj",
        "--no-launch-profile",
        "--urls",
        "http://localhost:5098"
      ],
      "port": 5098
    }
  ]
}
