<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS como reverse proxy para o app Node (Nitro node-server) em http://localhost:3000.
  Requer no IIS: URL Rewrite + Application Request Routing (ARR) com "Enable proxy" ligado.
  Ajuste a porta se o serviço Node não estiver na 3000.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
    <!-- Deixe o proxy repassar os headers/erros do Node sem reescrever -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
